{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.11.0/schema.json",
  "name": "{{VISUAL_ID_2}}",
  "position": {
    "x": 80,
    "y": 180,
    "z": 1,
    "height": 420,
    "width": 1760,
    "tabOrder": 1
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_calendar"
                    }
                  },
                  "Property": "date"
                }
              },
              "queryRef": "dim_calendar.date",
              "nativeQueryRef": "date"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Aggregation": {
                  "Expression": {
                    "Column": {
                      "Expression": {
                        "SourceRef": {
                          "Entity": "fact_sales"
                        }
                      },
                      "Property": "net_amount"
                    }
                  },
                  "Function": 0
                }
              },
              "queryRef": "Sum(fact_sales.net_amount)",
              "nativeQueryRef": "Total Net Sales"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}
