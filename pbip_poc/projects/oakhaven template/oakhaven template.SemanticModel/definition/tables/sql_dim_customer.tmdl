table sql_dim_customer
	isHidden
	lineageTag: 60157a56-9e5c-44e3-afe2-a1d8596c4810

	column sql_dim_customer
		dataType: string
		isHidden
		lineageTag: 4ceefc78-122a-4729-9da4-ff81d61dc8c3
		summarizeBy: none
		sourceColumn: sql_dim_customer

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition sql_dim_customer = m
		mode: import
		queryGroup: 'sql queries'
		source =
				let
				    Source = "SELECT DISTINCT #(cr)#(lf)    c.customer_id,#(cr)#(lf)    c.full_name,#(cr)#(lf)    c.email,#(cr)#(lf)    c.state,#(cr)#(lf)    c.customer_segment#(cr)#(lf)FROM dim_customer c#(cr)#(lf)WHERE c.customer_id IN (#(cr)#(lf)    SELECT customer_id #(cr)#(lf)    FROM fact_sales #(cr)#(lf)    ORDER BY order_date DESC, order_id, order_line_id #(cr)#(lf)    LIMIT 100#(cr)#(lf));"
				in
				    Source

	changedProperty = IsHidden

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Text

