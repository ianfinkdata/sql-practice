model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 'sql queries'

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["flat_sales_all","oakhavendatabasepath","fact_sales","dim_employee","dim_calendar"]

annotation PBI_ProTooling = ["TMDLView_Desktop","DevMode"]

ref table flat_sales_all
ref table fact_sales
ref table dim_employee
ref table dim_calendar

ref table _measures

ref cultureInfo en-US

