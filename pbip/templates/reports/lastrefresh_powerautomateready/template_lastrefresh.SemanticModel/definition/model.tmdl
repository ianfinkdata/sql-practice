model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["lastrefresh","PowerAutomateDateVariable","PowerAutomateLastRefreshQuery","PowerAutomateExpressionQuery","PADatasetQueries"]

annotation PBI_ProTooling = ["DaxQueryView_Desktop","DevMode"]

ref table lastrefresh
ref table PADatasetQueries

ref cultureInfo en-US

