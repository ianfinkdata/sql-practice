/// date only utc now equivalent for Power Automate Used in conditionlogic in power automate
expression PowerAutomateDateVariable = "utcNow('yyyy-MM-dd')" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: b92b2363-cccd-4b17-93ab-c3bf2ada932a

