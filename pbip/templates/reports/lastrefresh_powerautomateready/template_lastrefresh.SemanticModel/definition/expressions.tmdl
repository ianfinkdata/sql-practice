expression PowerAutomateLastRefreshQuery =
		let
		    Source = "EVALUATE ROW(""lastrefresh"", """" & FORMAT(MIN(lastrefresh[LastRefreshDateValue]), ""yyyy-MM-dd""))",
		    #"Converted to Table" = #table(1, {{Source}}),
		    #"Renamed Columns" = Table.RenameColumns(#"Converted to Table",{{"Column1", "Run A Query Against a Dataset"}}),
		    #"Changed Type" = Table.TransformColumnTypes(#"Renamed Columns",{{"Run A Query Against a Dataset", type text}})
		in
		    #"Changed Type"
	lineageTag: 08be6fe3-0188-4640-821b-02a55939d3c6

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression PowerAutomateExpressionQuery =
		let
		    Source = "EVALUATE ROW(""paexpression"", """" & MIN(lastrefresh[PowerAutomateUTCNowFormatting]))",
		    #"Converted to Table" = #table(1, {{Source}}),
		    #"Renamed Columns" = Table.RenameColumns(#"Converted to Table",{{"Column1", "Run A Query Against a Dataset"}}),
		    #"Changed Type" = Table.TransformColumnTypes(#"Renamed Columns",{{"Run A Query Against a Dataset", type text}})
		in
		    #"Changed Type"
	lineageTag: 5c58f906-c382-4a40-ad94-e58fb93e45b7

