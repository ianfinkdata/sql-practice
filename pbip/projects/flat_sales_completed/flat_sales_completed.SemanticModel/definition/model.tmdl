model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 'sql queries'

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["oakhavendatabasepath","sql_flat_sales_all","flat_sales_completed","sql_flat_sales_completed","sql_dim_product","sql_dim_date","dim_customer","dim_calendar"]

annotation PBI_ProTooling = ["TMDLView_Desktop","DevMode"]

ref table sql_flat_sales_all
ref table flat_sales_completed
ref table sql_flat_sales_completed
ref table sql_dim_product
ref table sql_dim_date
ref table dim_customer
ref table dim_calendar

ref table _measures

ref cultureInfo en-US

