table _measures
	lineageTag: a0000000-0000-4000-8000-000000000001

	/// [Tables: flat_sales_completed] Sum of actual net sales revenue earned after discounts.
	measure 'Total Net Revenue' = SUM(flat_sales_completed[net_amount])
		formatString: \$#,##0.00
		displayFolder: 01 - Revenue & Volume
		lineageTag: m0000002-0000-4000-8000-000000000002

	/// [Tables: flat_sales_completed] Total sum of merchandise item quantities sold.
	measure 'Total Units Sold' = SUM(flat_sales_completed[quantity])
		formatString: #,##0
		displayFolder: 01 - Revenue & Volume
		lineageTag: m0000003-0000-4000-8000-000000000003

	/// [Tables: flat_sales_completed] Count of distinct sales order transaction IDs.
	measure 'Total Orders' = DISTINCTCOUNT(flat_sales_completed[order_id])
		formatString: #,##0
		displayFolder: 03 - Order Metrics
		lineageTag: m0000004-0000-4000-8000-000000000004

	/// [Tables: flat_sales_completed] Mean net revenue earned per distinct sales order.
	measure 'Average Order Value' = DIVIDE([Total Net Revenue], [Total Orders], 0)
		formatString: \$#,##0.00
		displayFolder: 03 - Order Metrics
		lineageTag: m0000005-0000-4000-8000-000000000005

	/// [Tables: flat_sales_completed] Count of unique customers placing orders in selected period.
	measure 'Active Customer Count' = DISTINCTCOUNT(flat_sales_completed[customer_name])
		formatString: #,##0
		displayFolder: 04 - Customer Metrics
		lineageTag: m0000006-0000-4000-8000-000000000006

	/// [Tables: dim_calendar, flat_sales_completed] Total net revenue for the prior year comparable calendar period.
	measure 'Net Revenue PY' = CALCULATE([Total Net Revenue], SAMEPERIODLASTYEAR(dim_calendar[date]))
		formatString: \$#,##0.00
		displayFolder: 05 - Time Intelligence
		lineageTag: m0000011-0000-4000-8000-000000000011

	/// [Tables: dim_calendar, flat_sales_completed] Year-over-year percentage growth in total net revenue.
	measure 'Net Revenue YoY %' = DIVIDE([Total Net Revenue] - [Net Revenue PY], [Net Revenue PY], 0)
		formatString: 0.0%
		displayFolder: 05 - Time Intelligence
		lineageTag: m0000012-0000-4000-8000-000000000012

	column Value
		dataType: int64
		isHidden
		lineageTag: c0000001-0000-4000-8000-000000000001
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition _measures = calculated
		mode: import
		source = Row("Value", 1)

	annotation PBI_Id = t0000001-0000-4000-8000-000000000001

