table sql_dim_employee
	isHidden
	lineageTag: 40290057-dafc-4a1a-b105-70828199df3c

	column sql_dim_employee
		dataType: string
		isHidden
		lineageTag: 7b629e6f-4ccd-448a-b5f8-06d47d6dcf00
		summarizeBy: none
		sourceColumn: sql_dim_employee

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition sql_dim_employee = m
		mode: import
		queryGroup: 'sql queries'
		source =
				let
				    Source = "SELECT DISTINCT #(cr)#(lf)    e.employee_id,#(cr)#(lf)    e.full_name,#(cr)#(lf)    e.department,#(cr)#(lf)    e.region#(cr)#(lf)FROM dim_employee e#(cr)#(lf)WHERE e.employee_id IN (#(cr)#(lf)    SELECT employee_id #(cr)#(lf)    FROM fact_sales #(cr)#(lf)    ORDER BY order_date DESC, order_id, order_line_id #(cr)#(lf)    LIMIT 100#(cr)#(lf));"
				in
				    Source

	changedProperty = IsHidden

